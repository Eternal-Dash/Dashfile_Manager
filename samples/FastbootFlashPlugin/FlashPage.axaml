<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:api="clr-namespace:DashFile.PluginApi.Controls;assembly=DashFile.PluginApi"
             x:Class="FastbootFlashPlugin.FlashPage" x:CompileBindings="False">
  <UserControl.Styles>
    <Style Selector="Border.surface">
      <Setter Property="Background" Value="{DynamicResource PanelAlt}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="12,6"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="34"/></Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="Workspace" Height="540" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4"><TextBlock Text="分区刷写" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Classes="caption" Text="FASTBOOT / ADB ROOT　·　先预览，再写入；每份备份均校验长度与 SHA-256"/></StackPanel>
      <Button Classes="tool" Grid.Column="1" Content="导出日志" Command="{Binding ExportLogCommand}" VerticalAlignment="Center"/>
    </Grid>
    <Border Grid.Row="1" Classes="surface" Padding="14,12">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsEnabled="{Binding CanInteract}">
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" HorizontalAlignment="Stretch" PlaceholderText="选择设备 · 所有操作绑定序列号">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="tool" Grid.Column="1" Content="检测设备" Command="{Binding DetectCommand}"/>
          <Button Classes="tool" Grid.Column="2" Content="读取分区" Command="{Binding InspectCommand}"/>
        </Grid>
        <TextBlock Classes="caption" Text="{Binding DeviceSummary}"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="255,*" ColumnSpacing="12">
      <Border Classes="surface" Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
          <StackPanel Spacing="4"><TextBlock Text="设备分区" FontWeight="SemiBold"/><TextBlock Classes="caption" Text="{Binding CatalogSummary}"/></StackPanel>
          <TextBox Grid.Row="1" Text="{Binding Filter}" Watermark="搜索分区" IsEnabled="{Binding CanInteract}"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" IsEnabled="{Binding CanInteract}">
            <Button Classes="tool" Content="全选当前列表" Command="{Binding SelectAllCommand}" FontSize="11" Padding="8,4"/>
            <Button Classes="tool" Content="清空" Command="{Binding SelectNoneCommand}" FontSize="11" Padding="8,4"/>
          </StackPanel>
          <ListBox Grid.Row="3" ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}" IsEnabled="{Binding CanInteract}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,5">
              <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="Medium"/><TextBlock Classes="caption" Text="{Binding Detail}" FontSize="10"/></StackPanel>
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="surface" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Border Classes="seg" HorizontalAlignment="Left"><api:SegmentedTabs SelectedIndex="{Binding TabIndex}">
            <Button Classes="seg tabbtn" Content="镜像操作"/><Button Classes="seg tabbtn" Content="固件包"/><Button Classes="seg tabbtn" Content="批量回读"/><Button Classes="seg tabbtn" Content="任务日志"/>
          </api:SegmentedTabs></Border>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
              <StackPanel IsVisible="{Binding ImageTab}" Spacing="10" IsEnabled="{Binding CanInteract}">
                <TextBlock Text="写入单个分区" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Classes="caption" Text="点击左侧分区填入目标，也可手动输入。A/B 设备将按槽位解析并校验实际目标。"/>
                <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
                  <TextBox Text="{Binding TargetPartition}" Watermark="目标分区，例如 boot"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding Slot}" HorizontalAlignment="Stretch"/>
                </Grid>
                <TextBlock Classes="caption" Text="槽位 current 表示当前槽；a / b 表示指定槽。非 A/B 分区保持原名。"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding ImagePath}" Watermark="选择原始 / Android Sparse 镜像"/><Button Classes="tool" Grid.Column="1" Content="选择镜像" Command="{Binding PickImageCommand}"/></Grid>
                <Button Classes="tool pri" Content="生成刷写预览" Command="{Binding PreviewImageCommand}" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding PackageTab}" Spacing="10" IsEnabled="{Binding CanInteract}">
                <TextBlock Text="整包刷写与备份恢复" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Classes="caption" Text="支持 AOSP Fastboot update ZIP、平铺 .img 目录和本插件的 .dfbackup.zip / 备份目录。OTA payload、厂商压缩包及脚本不直接执行。镜像目录以文件名匹配分区。"/>
                <TextBox Text="{Binding PackagePath}" Watermark="选择固件包或镜像目录"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="tool" Content="选择 ZIP" Command="{Binding PickPackageCommand}"/><Button Classes="tool" Content="选择目录" Command="{Binding PickPackageFolderCommand}"/><ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding Slot}" Width="115"/></StackPanel>
                <TextBlock Classes="caption" Text="槽位选项用于镜像目录；原生 update ZIP 遵循包内指令与设备协议。不会自动清除数据或重启系统。"/>
                <Button Classes="tool pri" Content="解析并预览整包" Command="{Binding PreviewPackageCommand}" HorizontalAlignment="Left"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding BackupTab}" Spacing="10" IsEnabled="{Binding CanInteract}">
                <TextBlock Text="可验证的镜像回读" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Classes="caption" Text="勾选左侧分区进行选择回读，或备份全部已枚举分区。Fastboot fetch 支持取决于设备；不支持时可在已授权且有 Root 的 Android 下使用 ADB 回读。"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding OutputFolder}" Watermark="回读输出目录"/><Button Classes="tool" Grid.Column="1" Content="选择目录" Command="{Binding PickOutputCommand}"/></Grid>
                <CheckBox Content="同时生成 ZIP 备份包（需要双份磁盘空间）" IsChecked="{Binding ZipBackup}"/>
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Classes="tool" Content="回读勾选分区" Command="{Binding BackupSelectedCommand}"/><Button Classes="tool" Content="回读全部已枚举分区" Command="{Binding BackupAllCommand}"/></StackPanel>
                <TextBlock Classes="caption" Text="逐分区流式写入磁盘并校验长度与哈希。失败即停，保留清单和 .partial 结果。枚举备份不包含设备未暴露区域，不能等同于厂商完整救砖包。"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding LogTab}" Spacing="10"><TextBlock Text="任务记录" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MinHeight="220"/></StackPanel>
              <Border BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="0,12,0,0" IsVisible="{Binding !BackupTab}">
                <StackPanel Spacing="8" IsVisible="{Binding !LogTab}">
                  <TextBlock Text="刷写约束" FontWeight="SemiBold"/>
                  <CheckBox Content="设备未报告解锁状态：我已自行确认已解锁" IsChecked="{Binding ManualUnlock}" IsEnabled="{Binding CanInteract}"/>
                  <CheckBox Content="允许关键 / 数据分区（可能清空数据或影响启动）" IsChecked="{Binding AllowCritical}" IsEnabled="{Binding CanInteract}"/>
                  <TextBlock Classes="caption" Text="已明确锁定的设备始终禁止刷写。逻辑分区需在 fastbootd 中操作。"/>
                  <TextBlock Text="执行计划" FontWeight="SemiBold" Margin="0,6,0,0"/>
                  <TextBox Text="{Binding PlanText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="220" FontSize="11"/>
                  <Button Classes="tool pri" Content="确认并开始刷写" Command="{Binding ExecuteCommand}" IsEnabled="{Binding HasPlan}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding CanInteract}"><TextBlock Classes="caption" Text="切换模式" VerticalAlignment="Center"/><Button Classes="tool" Content="Bootloader" Command="{Binding RebootCommand}" CommandParameter="bootloader" FontSize="11"/><Button Classes="tool" Content="Fastbootd" Command="{Binding RebootCommand}" CommandParameter="fastboot" FontSize="11"/><Button Classes="tool" Content="重启系统" Command="{Binding RebootCommand}" CommandParameter="system" FontSize="11"/></StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Classes="surface" Padding="12,10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"/><ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="3" IsVisible="{Binding IsBusy}"/><TextBlock Classes="caption" Text="{Binding ProgressText}" IsVisible="{Binding IsBusy}"/></StackPanel><Button Classes="tool" Grid.Column="1" Content="停止后续任务" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" VerticalAlignment="Center"/></Grid>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
