<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FastbootFlashPlugin.FlashPage" x:CompileBindings="False">
  <UserControl.Resources>
    <ControlTheme x:Key="PartitionRowTheme" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><ControlTemplate><Border x:Name="RowSurface" Background="Transparent" CornerRadius="{DynamicResource RadiusCtl}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/></Border></ControlTemplate></Setter>
      <Style Selector="^:pointerover /template/ Border#RowSurface"><Setter Property="Background" Value="{DynamicResource HoverLayer}"/></Style>
      <Style Selector="^:selected /template/ Border#RowSurface"><Setter Property="Background" Value="{DynamicResource SelBg}"/></Style>
    </ControlTheme>
    <ControlTheme x:Key="FoldTheme" TargetType="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template"><ControlTemplate>
        <Grid RowDefinitions="Auto,Auto">
          <ToggleButton x:Name="FoldHeader" Classes="fold-header" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <Grid ColumnDefinitions="*,20" ColumnSpacing="8"><ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"/>
              <Path Grid.Column="1" Classes="fold-arrow" Data="M4,2 L10,8 L4,14" Width="7" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.7" RenderTransformOrigin="50%,50%" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
          </ToggleButton>
          <ContentPresenter x:Name="FoldBody" Grid.Row="1" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="{TemplateBinding IsExpanded}" Margin="12,2,12,12"/>
        </Grid>
      </ControlTemplate></Setter>
      <Style Selector="^ /template/ Path.fold-arrow">
        <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/></Transitions></Setter>
      </Style>
      <Style Selector="^:expanded /template/ Path.fold-arrow"><Setter Property="RenderTransform" Value="rotate(90deg)"/></Style>
      <Style Selector="^ /template/ ContentPresenter#FoldBody">
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="RenderTransform" Value="translate(0px,4px)"/>
        <Setter Property="Transitions"><Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
        </Transitions></Setter>
      </Style>
      <Style Selector="^:expanded /template/ ContentPresenter#FoldBody">
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="RenderTransform" Value="translate(0px,0px)"/>
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.flash-surface"><Setter Property="Background" Value="{DynamicResource PanelAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/></Style>
    <Style Selector="TextBlock.flash-caption"><Setter Property="Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="TextBlock.flash-label"><Setter Property="Foreground" Value="{DynamicResource TextMain}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.tool"><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="10,5"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="12.5"/></Style>
    <Style Selector="CheckBox"><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="ToggleButton.fold-header"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,11"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextMain}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="CornerRadius" Value="{DynamicResource RadiusCtl}"/></Style>
    <Style Selector="ToggleButton.fold-header:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverLayer}"/></Style>
    <Style Selector="ToggleButton.fold-header:checked /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentFill}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource TextMain}"/></Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource TextMuted}"/><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="Border.flash-divider"><Setter Property="Height" Value="1"/><Setter Property="Margin" Value="12,0"/><Setter Property="Background" Value="{DynamicResource StrokeSoft}"/></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="Workspace" Height="560" RowDefinitions="Auto,*,Auto" RowSpacing="10">
      <!-- One selection model, shared safely by the navigation and plugin-management views. -->
      <Border Classes="flash-surface" Padding="12,10">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="140,*,Auto,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding DeviceModes}" SelectedIndex="{Binding DeviceModeIndex}" IsEnabled="{Binding CanInteract}" HorizontalAlignment="Stretch" FontSize="12"/>
            <Grid Grid.Column="1">
              <ComboBox x:Name="DevicePicker" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsVisible="{Binding !AutoDetect}" IsEnabled="{Binding DeviceSelectionEnabled}" HorizontalAlignment="Stretch" PlaceholderText="检测设备后明确选择目标" FontSize="12.5">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Border IsVisible="{Binding AutoDetect}" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" CornerRadius="{DynamicResource RadiusCtl}" Padding="10,7">
                <TextBlock Text="{Binding TargetDisplay}" Foreground="{DynamicResource TextMain}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <Button Grid.Column="2" Classes="tool" Content="检测设备" Command="{Binding DetectCommand}" IsEnabled="{Binding CanInteract}"/>
            <Button Grid.Column="3" Classes="tool pri" Content="读取分区" Command="{Binding InspectCommand}" IsEnabled="{Binding CanUseDevice}"/>
          </Grid>
          <TextBlock Grid.Row="1" Classes="flash-caption" Text="{Binding DeviceSummary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Grid>
      </Border>
      <Grid x:Name="Columns" Grid.Row="1" ColumnDefinitions="*,330" ColumnSpacing="10">
        <Border Classes="flash-surface" ClipToBounds="True">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="12,11">
              <TextBox x:Name="PartitionSearch" Text="{Binding Filter}" Watermark="搜索分区名称…" IsEnabled="{Binding CanInteract}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><Button Classes="tool" Content="全选" Command="{Binding SelectAllCommand}" IsEnabled="{Binding CanUsePartitions}" ToolTip.Tip="只选择当前筛选结果"/><Button Classes="tool" Content="清空" Command="{Binding SelectNoneCommand}" IsEnabled="{Binding CanUsePartitions}"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource ChipBg}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,1,0,1" Padding="12,8">
              <Grid ColumnDefinitions="30,*,76,138" ColumnSpacing="8"><TextBlock Classes="flash-caption" Text="选"/><TextBlock Grid.Column="1" Classes="flash-caption" Text="分区 / 类型"/><TextBlock Grid.Column="2" Classes="flash-caption" Text="大小" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Classes="flash-caption" Text="镜像文件"/></Grid>
            </Border>
            <Grid Grid.Row="2">
              <ListBox x:Name="PartitionList" ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}" Background="Transparent" BorderThickness="0" ItemContainerTheme="{StaticResource PartitionRowTheme}" IsEnabled="{Binding CanInteract}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="4,3">
                <ListBox.ItemTemplate><DataTemplate>
                  <Border BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="8,8">
                    <Grid ColumnDefinitions="30,*,76,138" ColumnSpacing="8">
                      <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Classes="flash-caption" Text="{Binding KindText}" FontSize="11"/></StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource TextSub}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      <Button Grid.Column="3" Classes="tool" Command="{Binding $parent[UserControl].DataContext.PickRowImageCommand}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" ToolTip.Tip="{Binding ImagePath}"><TextBlock Text="{Binding ImageLabel}" TextTrimming="CharacterEllipsis"/></Button>
                    </Grid>
                  </Border>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <StackPanel IsVisible="{Binding ListEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9" MaxWidth="290" Margin="16" IsHitTestVisible="False">
                <Path Data="M2,2 H18 V18 H2 Z M2,7 H18 M8,7 V18" Width="30" Height="30" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.2" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Classes="flash-label" Text="{Binding EmptyTitle}" HorizontalAlignment="Center"/>
                <TextBlock Classes="flash-caption" Text="{Binding EmptyDescription}" TextAlignment="Center"/>
              </StackPanel>
            </Grid>
            <Border Grid.Row="3" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="12,9"><TextBlock Classes="flash-caption" Text="{Binding CatalogSummary}"/></Border>
          </Grid>
        </Border>
        <Border Grid.Column="1" Classes="flash-surface" Padding="4" ClipToBounds="True">
          <ScrollViewer x:Name="OperationsScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Expander x:Name="BasicSection" Theme="{StaticResource FoldTheme}" Header="基础操作" IsExpanded="{Binding IsBasicsOpen, Mode=TwoWay}">
                <StackPanel Spacing="8" IsEnabled="{Binding CanUsePartitions}">
                  <TextBlock Classes="flash-caption" Text="每个勾选分区都需选择镜像。先生成计划，核对后写入。"/>
                  <Button Classes="tool pri" Content="预览选中分区刷写" Command="{Binding FlashSelectedCommand}" IsEnabled="{Binding CanWriteDevice}" HorizontalAlignment="Stretch"/>
                  <Button Classes="tool" Content="回读选中分区" Command="{Binding BackupSelectedCommand}" HorizontalAlignment="Stretch"/>
                  <Button Classes="tool" Content="擦除选中分区…" Command="{Binding EraseSelectedCommand}" IsEnabled="{Binding CanWriteDevice}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Expander>
              <Border Classes="flash-divider"/>
              <Expander x:Name="PackageSection" Theme="{StaticResource FoldTheme}" Header="固件包与备份恢复" IsExpanded="{Binding IsPackageOpen, Mode=TwoWay}">
                <StackPanel Spacing="8" IsEnabled="{Binding CanInteract}">
                  <TextBlock Classes="flash-caption" Text="AOSP update ZIP、镜像目录和本插件备份包；不执行厂商脚本或 OTA payload。"/>
                  <TextBox Text="{Binding PackagePath}" Watermark="固件包或镜像目录"/>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="6"><Button Classes="tool" Content="选择 ZIP" Command="{Binding PickPackageCommand}"/><Button Grid.Column="1" Classes="tool" Content="选择目录" Command="{Binding PickPackageFolderCommand}"/></Grid>
                  <Button Classes="tool pri" Content="解析并预览整包" Command="{Binding PreviewPackageCommand}" IsEnabled="{Binding CanWriteDevice}" HorizontalAlignment="Stretch"/>
                  <TextBlock Classes="flash-caption" Text="备份恢复会核对机型、设备序列号、清单及 SHA-256。"/>
                </StackPanel>
              </Expander>
              <Border Classes="flash-divider"/>
              <Expander x:Name="ImageSection" Theme="{StaticResource FoldTheme}" Header="指定镜像与槽位" IsExpanded="{Binding IsImageOpen, Mode=TwoWay}">
                <StackPanel Spacing="8" IsEnabled="{Binding CanInteract}">
                  <Grid ColumnDefinitions="*,90" ColumnSpacing="6"><TextBox Text="{Binding TargetPartition}" Watermark="目标分区，如 boot"/><ComboBox Grid.Column="1" ItemsSource="{Binding Slots}" SelectedItem="{Binding Slot}" HorizontalAlignment="Stretch"/></Grid>
                  <TextBlock Classes="flash-caption" Text="current 为当前槽，a / b 为指定槽；整包 ZIP 遵循包内指令。"/>
                  <TextBox Text="{Binding ImagePath}" Watermark="原始或 Sparse 镜像"/>
                  <Button Classes="tool" Content="选择镜像" Command="{Binding PickImageCommand}" HorizontalAlignment="Stretch"/>
                  <Button Classes="tool pri" Content="预览单镜像刷写" Command="{Binding PreviewImageCommand}" IsEnabled="{Binding CanWriteDevice}" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Expander>
              <Border Classes="flash-divider"/>
              <Expander x:Name="BackupSection" Theme="{StaticResource FoldTheme}" Header="回读与备份选项" IsExpanded="{Binding IsBackupOpen, Mode=TwoWay}">
                <StackPanel Spacing="8" IsEnabled="{Binding CanInteract}">
                  <TextBox Text="{Binding OutputFolder}" Watermark="输出目录"/>
                  <Button Classes="tool" Content="选择输出目录" Command="{Binding PickOutputCommand}" HorizontalAlignment="Stretch"/>
                  <CheckBox Content="同时生成 ZIP（需要双份空间）" IsChecked="{Binding ZipBackup}"/>
                  <Button Classes="tool" Content="回读全部已枚举分区" Command="{Binding BackupAllCommand}" IsEnabled="{Binding CanUsePartitions}" HorizontalAlignment="Stretch"/>
                  <TextBlock Classes="flash-caption" Text="Fastboot 回读依赖设备支持 fetch；ADB 回读需 Root。已枚举分区备份不等于厂商完整 ROM。"/>
                </StackPanel>
              </Expander>
              <Border Classes="flash-divider"/>
              <Expander x:Name="RebootSection" Theme="{StaticResource FoldTheme}" Header="重启至…">
                <StackPanel Spacing="7" IsEnabled="{Binding CanUseDevice}">
                  <Button Classes="tool" Content="系统" Command="{Binding RebootToCommand}" CommandParameter="system" HorizontalAlignment="Stretch"/>
                  <Button Classes="tool" Content="Fastbootd" Command="{Binding RebootToCommand}" CommandParameter="fastboot" HorizontalAlignment="Stretch"/>
                  <Button Classes="tool" Content="Fastboot / Bootloader" Command="{Binding RebootToCommand}" CommandParameter="bootloader" HorizontalAlignment="Stretch"/>
                  <Button Classes="tool" Content="Recovery" Command="{Binding RebootToCommand}" CommandParameter="recovery" HorizontalAlignment="Stretch"/>
                  <Button Classes="tool" Content="9008 / EDL" Command="{Binding RebootToCommand}" CommandParameter="edl" HorizontalAlignment="Stretch"/>
                  <TextBlock Classes="flash-caption" Text="EDL 为厂商扩展，仅部分机型支持；进入前确认已具备退出或恢复手段。"/>
                </StackPanel>
              </Expander>
              <Border Classes="flash-divider"/>
              <Expander x:Name="AdvancedSection" Theme="{StaticResource FoldTheme}" Header="查询与刷写约束" IsExpanded="{Binding IsAdvancedOpen, Mode=TwoWay}">
                <StackPanel Spacing="8" IsEnabled="{Binding CanInteract}">
                  <TextBox Text="{Binding CommandText}" Watermark="如 getvar all" FontFamily="Consolas"/>
                  <Button Classes="tool" Content="执行查询命令" Command="{Binding RunCommandCommand}" IsEnabled="{Binding CanUseDevice}" HorizontalAlignment="Stretch"/>
                  <TextBlock Classes="flash-caption" Text="支持 getvar 和 oem device-info；写入、擦除和解锁指令不从查询入口执行。"/>
                  <CheckBox Content="未报告解锁状态：我已核实已解锁" IsChecked="{Binding ManualUnlock}"/>
                  <CheckBox Content="允许关键 / 数据分区" IsChecked="{Binding AllowCritical}"/>
                  <TextBlock Classes="flash-caption" Text="明确锁定的设备禁止写入；逻辑分区需 fastbootd。此处不提供 BL 解锁。"/>
                </StackPanel>
              </Expander>
              <Border Classes="flash-divider"/>
              <Expander x:Name="PlanSection" Theme="{StaticResource FoldTheme}" Header="执行计划" IsExpanded="{Binding IsPlanOpen, Mode=TwoWay}">
                <StackPanel Spacing="9"><TextBox Text="{Binding PlanText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="210" FontSize="12"/><Button Classes="tool pri" Content="确认并开始刷写…" Command="{Binding ExecuteCommand}" IsEnabled="{Binding HasPlan}" HorizontalAlignment="Stretch"/></StackPanel>
              </Expander>
              <Border Classes="flash-divider"/>
              <Expander x:Name="LogSection" Theme="{StaticResource FoldTheme}" Header="任务日志" IsExpanded="{Binding IsLogOpen, Mode=TwoWay}">
                <StackPanel Spacing="8"><TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Height="180"/><Button Classes="tool" Content="导出日志" Command="{Binding ExportLogCommand}" IsEnabled="{Binding CanInteract}" HorizontalAlignment="Stretch"/></StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <Border Grid.Row="2" Classes="flash-surface" Padding="12,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="{Binding Status}" FontSize="12.5" TextWrapping="Wrap"/><ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="4" IsVisible="{Binding IsBusy}"/><TextBlock Classes="flash-caption" Text="{Binding ProgressText}" IsVisible="{Binding IsBusy}"/></StackPanel><Button Grid.Column="1" Classes="tool" Content="停止后续任务" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" VerticalAlignment="Center"/></Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
