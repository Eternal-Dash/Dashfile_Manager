<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DashFile.Views.PropertyDialog"
        Title="属性" Width="560" SizeToContent="Height"
        MaxHeight="600" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
  <Window.Styles>
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="{DynamicResource SelBg}"/>
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextMain}"/>
    </Style>
  </Window.Styles>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="22" Spacing="16">

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PanelAlt}"
              BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <TextBlock x:Name="IconGlyph" Text="📄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <SelectableTextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMain}" TextWrapping="Wrap"/>
        <SelectableTextBlock x:Name="PathText" Classes="sub" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Stroke}"
            BorderThickness="1" CornerRadius="8" Padding="14,10">
      <Grid x:Name="InfoGrid" ColumnDefinitions="118,*" RowDefinitions="Auto" RowSpacing="9"/>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="tool" Content="关闭" Click="OnClose"/>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
