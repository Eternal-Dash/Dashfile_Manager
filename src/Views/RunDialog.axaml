<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DashFile.Views.RunDialog"
        Title="执行命令" Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
  <DockPanel LastChildFill="True">

    <Border Classes="bar" DockPanel.Dock="Top">
      <StackPanel Spacing="2">
        <TextBlock Text="在设备上执行命令" Foreground="{DynamicResource TextMain}" FontSize="15"/>
        <TextBlock Text="可执行 shell 脚本、二进制程序，或任意命令；输出会显示在下方"
                   Classes="sub"/>
      </StackPanel>
    </Border>

    <Border Classes="footer" DockPanel.Dock="Bottom" Padding="14,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <CheckBox x:Name="UseRootBox" Content="使用 root 权限执行（su）" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="StateText" Classes="sub" Margin="14,0"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="tool" Content="关闭" Click="OnClose"/>
          <Button Classes="tool pri" x:Name="RunBtn" Content="开始执行" Click="OnRun"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid RowDefinitions="Auto,Auto,6,*" Margin="14,12,14,8">

      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock Text="命令（相对路径请在前面加 cd 到目标目录）" Classes="sub"/>
        <TextBox x:Name="CmdBox" Classes="path" Height="76"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas, Cascadia Mono, monospace"/>
        <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
          <WrapPanel>
            <Button Classes="tool" Content="执行选中文件 (sh)" Click="OnFillSh"/>
            <Button Classes="tool" Content="列出目录" Click="OnFillLs"/>
            <Button Classes="tool" Content="查看权限" Click="OnFillPerm"/>
            <Button Classes="tool" Content="清空输出" Click="OnClear"/>
          </WrapPanel>
          <!-- 发送设备按键：与命令按钮分开，靠右侧但不越界 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                      VerticalAlignment="Center" Margin="10,0,0,0">
            <Border Width="1" Background="{DynamicResource StrokeSoft}" Margin="0,3,8,3"/>
            <Button Classes="tool" Content="音量 −" Padding="9,5" Click="OnVolDown"
                    Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource AccentDeep}"
                    Background="{DynamicResource AccentBg}" ToolTip.Tip="发送音量减（脚本等按键时用）"/>
            <Button Classes="tool" Content="音量 ＋" Padding="9,5" Click="OnVolUp"
                    Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource AccentDeep}"
                    Background="{DynamicResource AccentBg}" ToolTip.Tip="发送音量加"/>
            <Button Classes="tool" Content="电源" Padding="9,5" Click="OnPower"
                    Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource AccentDeep}"
                    Background="{DynamicResource AccentBg}" ToolTip.Tip="发送电源键"/>
          </StackPanel>
        </Grid>
      </StackPanel>

      <TextBlock Grid.Row="1" Text="输出" Classes="sub" Margin="0,10,0,4"/>

      <TextBox Grid.Row="3" x:Name="OutBox"
               AcceptsReturn="True" IsReadOnly="True"
               TextWrapping="NoWrap"
               FontFamily="Consolas, Cascadia Mono, monospace"
               FontSize="13.5"
               Background="{DynamicResource PanelAlt}"
               Foreground="{DynamicResource TextSub}"
               BorderThickness="1"
               BorderBrush="{DynamicResource Stroke}"
               CornerRadius="6"
               Padding="10"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Grid>
  </DockPanel>
</Window>
