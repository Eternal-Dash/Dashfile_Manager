<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DashFile.Views.ConfirmDialog"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="TitleText" Text="确认" FontSize="15.5" FontWeight="SemiBold"
               Foreground="{DynamicResource TextMain}"/>
    <TextBlock x:Name="MessageText" Text="" TextWrapping="Wrap" Classes="value"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="tool" Content="取消" Click="OnCancel"/>
      <Button Classes="tool" Content="确定" Click="OnOk"/>
    </StackPanel>
  </StackPanel>
</Window>
