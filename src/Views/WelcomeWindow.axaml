<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DashFile.Views.WelcomeWindow"
        Title="欢迎使用DashFile哦！" Width="656" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}"
        FontFamily="Microsoft YaHei UI, Segoe UI">



  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WHair}"/>
      <Setter Property="Background" Value="{DynamicResource WCard}"/>
      <Setter Property="Padding" Value="24,18,24,20"/>
    </Style>
    <Style Selector="Border.card.author">
      <Setter Property="Background" Value="{DynamicResource WCardWarm}"/>
    </Style>

    <Style Selector="TextBlock.cardtitle">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="LetterSpacing" Value="0.3"/>
      <Setter Property="Foreground" Value="{DynamicResource WBlue}"/>
    </Style>
    <Style Selector="TextBlock.cardtitle.purple">
      <Setter Property="Foreground" Value="{DynamicResource WPurple}"/>
    </Style>

    <Style Selector="TextBlock.cardbody">
      <Setter Property="FontSize" Value="13.8"/>
      <Setter Property="LineHeight" Value="23"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource WSub}"/>
      <Setter Property="Margin" Value="0,13,0,0"/>
    </Style>

    <Style Selector="Border.verpill">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Background" Value="{DynamicResource WBlueTint}"/>
      <Setter Property="Padding" Value="9,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.verpill > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WBlue}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <Style Selector="Border.glow">
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <Style Selector="Border.note">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource WInset}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource WHair}"/>
      <Setter Property="Padding" Value="16,13"/>
    </Style>
  </Window.Styles>

  <Panel>
    <Border Classes="glow" Background="{DynamicResource WGlow}" VerticalAlignment="Top" Height="230"/>
    <DockPanel LastChildFill="True">

    <Border Classes="footer" DockPanel.Dock="Bottom">
      <Grid ColumnDefinitions="*,Auto">
        <CheckBox x:Name="DontShowBox" Content="再也不要看到提示了！" IsChecked="False"
                  VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="tool pri" Content="我知道了" Click="OnOk"/>
      </Grid>
    </Border>

    <StackPanel Margin="24,22,24,16" Spacing="14">

      <!-- 头部：品牌居中，版本做成淡蓝胶囊 -->
      <StackPanel Spacing="9" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="DashFile" FontSize="21" FontWeight="Bold"
                     Foreground="{DynamicResource WText}" LetterSpacing="0.4"/>
          <Border Classes="verpill">
            <TextBlock x:Name="VerText" Text=""/>
          </Border>
        </StackPanel>
        <TextBlock Text="手机无需任何APP：开了调试，插线即用！"
                   HorizontalAlignment="Center" FontSize="13.2"
                   Foreground="{DynamicResource WSub}"/>
      </StackPanel>

      <Border Classes="card" Margin="0,4,0,0">
        <StackPanel>
          <TextBlock Classes="cardtitle" Text="①请开启USB调试"/>
          <TextBlock Classes="cardbody"
                     Text="设置 → 关于手机 → 连点七下「版本号」(次数可能有变化哦)，开发者选项就冒出来了呢。进去找到，并把「USB 调试」打开，再插线。手机上会问「允许 USB 调试吗」，勾上「一律允许」再确定，不然后续就真的会很麻烦的说。"/>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel>
          <TextBlock Classes="cardtitle purple" Text="②有root的话，记得也给shell一份哦？"/>
          <TextBlock Classes="cardbody"
                     Text="需要你在你的root管理器的超级用户页中，找到shell并授予root，这样工具就能直接读写底层目录，同时也可以装模块，改权限啦。没有也可以用，只不过有些功能会变成棍木呢……"/>
        </StackPanel>
      </Border>

      <Border Classes="card author">
        <StackPanel>
          <TextBlock Classes="cardtitle purple" Text="③ 关于作者"/>
          <TextBlock Classes="cardbody"
                     Text="欸，到我了？本工具由EternalDash(恒定破折号)个人开发。使用GPL v3许可证，怎么改、怎么再分发都可以哦。但唯一一点就是一定要留着我的署名，拜托了！"/>
        </StackPanel>
      </Border>

      <!-- 说明块：隐私 + QQ 群 -->
      <Border Classes="note">
        <StackPanel Spacing="7">
          <TextBlock TextWrapping="Wrap" FontSize="12.8" LineHeight="21"
                     Foreground="{DynamicResource WMuted}"
                     Text="工具不联网、不上传、不收集任何东西(不会像嘎啦嘛一样偷偷把你开源)；浏览操作严格只读，退出时会清掉临时文件。"/>
          <TextBlock TextWrapping="Wrap" FontSize="12.8" LineHeight="21"
                     Foreground="{DynamicResource WBlue}"
                     Text="QQ群:861078054，欢迎来玩哦。"/>
        </StackPanel>
      </Border>
    </StackPanel>
    </DockPanel>
  </Panel>
</Window>
